# Copy to .env and fill in. .env is gitignored - never commit a real key.

# Web-search provider: SerpApi (https://serpapi.com), free tier 250 searches.
# NOTE: SerpApi (serpapi.com) and Serper (serper.dev) are different services.
# A key from one returns 403 against the other. This server targets SerpApi.
SERPAPI_API_KEY=your-serpapi-key-here

# Set to 1 to serve deterministic fixtures instead of calling the network.
# Useful while developing (the free tier is metered) and as demo insurance if
# the venue wifi is unreliable. Responses are marked degraded=true and every
# result title is prefixed [MOCK], so fixtures can never pass as live data.
MOCK_WEB_SEARCH=0

# web.search cache TTL in seconds. The brief requires 60-300; values outside
# that range are clamped.
WEB_SEARCH_TTL=180

# Minimum seconds between live provider calls (quota and ToS protection).
WEB_SEARCH_MIN_INTERVAL=1.0

# Comma-separated domain allowlist for web.search results. Unset uses the
# built-in retailer list in mcp_server/allowlist.py.
# WEB_SEARCH_ALLOWLIST=amazon.com,walmart.com,target.com

# Override the Chroma index location. Defaults to <repo>/chroma.
# CHROMA_PATH=/absolute/path/to/chroma

# Override the JSONL audit log path. Defaults to <repo>/logs/mcp_requests.jsonl
# MCP_LOG_PATH=/absolute/path/to/mcp_requests.jsonl
